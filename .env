FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-64-character-string

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=dsg_bank

# Optional: overrides the individual MYSQL_* values above if set
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/dsg_bank

SESSION_COOKIE_SECURE=false
